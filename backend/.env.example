PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Signup verification uses Supabase Auth email OTP. Its email template must include {{ .Token }}, not {{ .ConfirmationURL }}.
# Password-reset emails still use EmailJS until that separate flow is migrated.
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_RESET_TEMPLATE_ID=your_emailjs_password_reset_template_id
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
