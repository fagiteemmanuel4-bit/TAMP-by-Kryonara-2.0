{
  "functions": {
    "api/[...slug].js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/ADMIN:slug*", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
